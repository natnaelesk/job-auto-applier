# Copy this file to `.env` and fill in real values.
# The real .env is git-ignored — secrets never leave your machine.

# --- Phase 1: Telegram (my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL=            # legacy single channel, e.g. @ethio_jobs
# Prefer this for multiple sources (comma-separated @handles or t.me links):
# Example (replace with YOUR channels): TELEGRAM_CHANNELS=@channel_one,@channel_two
TELEGRAM_CHANNELS=

# --- Phase 2+: Cursor SDK (cursor.com/dashboard -> Integrations) ---
CURSOR_API_KEY=

# --- Phase 4: Notion (notion.so/my-integrations) ---
NOTION_TOKEN=
NOTION_DATABASE_ID=          # Ethiopia tracker — created automatically on first run if empty
NOTION_FOREIGN_DATABASE_ID=  # "Foreign Jobs Hunt" — created automatically on first foreign sync

# --- Foreign job search (freehire.dev + LinkedIn guest) ---
FOREIGN_SEARCH_QUERIES=backend developer,full stack developer,python developer,react developer
FOREIGN_SEARCH_LOCATION=Remote
FOREIGN_SEARCH_DAYS=14
FOREIGN_SEARCH_LIMIT=20
FREEHIRE_ENABLED=true
FREEHIRE_API_URL=https://freehire.dev
# LinkedIn guest: personal / low-volume only (against LinkedIn ToS if abused)
LINKEDIN_ENABLED=true
LINKEDIN_MAX_PAGES=2

# --- Phase 6: Gmail (Google Cloud Console, OAuth desktop credential) ---
# Path to the downloaded credentials.json file:
GMAIL_CREDENTIALS_FILE=credentials.json

# --- Behavior settings ---
MATCH_THRESHOLD_APPLY=50     # score >= this: apply / matched
MATCH_THRESHOLD_REVIEW=35    # score >= this but < apply: flag for review
APPROVAL_MODE=confident      # always | confident | never
PLAYWRIGHT_HEADLESS=false
# Apply browser: firefox (default) | chrome | edge | chromium
PLAYWRIGHT_BROWSER=firefox
# Chrome CDP only (ignored for firefox). Example after start_real_chrome.ps1:
# PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222
PLAYWRIGHT_CDP_URL=
# true = Open Link in your real default browser (accounts/logins stay yours)
APPLY_SYSTEM_BROWSER=true
# PLAYWRIGHT_EXECUTABLE=C:\Program Files\Mozilla Firefox\firefox.exe
# BROWSER_USER_DATA_DIR=
MAX_APPLY_PER_RUN=10
# Tip: for Google login issues on automated browsers, use Chrome + CDP instead.
