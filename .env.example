# Copy this file to `.env` and fill in real values.
# The real .env is git-ignored — secrets never leave your machine.
# Full map + where to get each key: ENV.md

# =============================================================================
# REQUIRED for first Telegram + AI run
# =============================================================================

# --- Telegram (https://my.telegram.org → API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Channels to scan = list of @usernames (comma-separated, or a JSON array).
# Add / remove usernames as needed. @ is optional. t.me links also work.
#
# Comma list (recommended):
TELEGRAM_CHANNELS=@josad_software,@freelance_ethio,@hahujobs,@Maroset,@AbiLink7
#
# Same thing as a JSON array (also supported):
# TELEGRAM_CHANNELS=["@josad_software","@freelance_ethio","@hahujobs","@Maroset","@AbiLink7"]
#
# Or paste t.me links:
# TELEGRAM_CHANNELS=https://t.me/freelance_ethio,https://t.me/hahujobs
#
# Legacy single channel (only used if TELEGRAM_CHANNELS is empty):
TELEGRAM_CHANNEL=@josad_software

# How far back the first Telegram scan goes (days). Later scans are incremental.
FIRST_SCAN_DAYS=7

# --- Cursor SDK (https://cursor.com/dashboard → Integrations / API) ---
CURSOR_API_KEY=
# Optional model override (default below is fine for most runs)
CURSOR_MODEL=composer-2.5

# =============================================================================
# OPTIONAL — leave empty / defaults until you need them
# =============================================================================

# --- Notion (https://www.notion.so/my-integrations) ---
# Create an integration, share a page with it, then run Gather/Notion once.
# Database IDs are written back into .env automatically on first sync.
NOTION_TOKEN=
NOTION_DATABASE_ID=          # Ethiopia tracker — auto-created if empty
NOTION_FOREIGN_DATABASE_ID=  # "Foreign Jobs Hunt" — auto-created on first foreign sync

# --- Foreign job search (freehire.dev + LinkedIn guest) ---
# Set both ENABLED=false for Ethiopia-Telegram-only setups.
FOREIGN_SEARCH_QUERIES=backend developer,full stack developer,python developer,react developer
FOREIGN_SEARCH_LOCATION=Remote
FOREIGN_SEARCH_DAYS=14
FOREIGN_SEARCH_LIMIT=20
FREEHIRE_ENABLED=true
FREEHIRE_API_URL=https://freehire.dev
# LinkedIn guest: personal / low-volume only (against LinkedIn ToS if abused)
LINKEDIN_ENABLED=true
LINKEDIN_MAX_PAGES=2

# --- Gmail (Google Cloud Console → OAuth Desktop client) ---
# Download JSON as credentials.json in the project root (git-ignored).
# First gmail run opens a browser; token.json is created locally.
GMAIL_CREDENTIALS_FILE=credentials.json

# --- Match / apply behavior ---
MATCH_THRESHOLD_APPLY=50     # score >= this: apply / matched
MATCH_THRESHOLD_REVIEW=35    # score >= this but < apply: flag for review
APPROVAL_MODE=confident      # always | confident | never
MAX_APPLY_PER_RUN=10

# --- Playwright / browser (Apply tab form-fill) ---
PLAYWRIGHT_HEADLESS=false
# Apply browser: firefox (default) | chrome | edge | chromium
PLAYWRIGHT_BROWSER=firefox
# Chrome CDP only (ignored for firefox). Example after start_real_chrome.ps1:
# PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222
PLAYWRIGHT_CDP_URL=
# true = Open Link in your real default browser (accounts/logins stay yours)
APPLY_SYSTEM_BROWSER=true
# Optional absolute path to browser binary (Linux example):
# PLAYWRIGHT_EXECUTABLE=/usr/bin/firefox
# BROWSER_USER_DATA_DIR=
# Tip: for Google login issues on automated browsers, use Chrome + CDP instead.
