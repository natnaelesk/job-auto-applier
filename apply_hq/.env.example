# Copy to apply_hq/.env (or use repo-root .env). Never commit real secrets.
# Full map: ../ENV.md
#
# Apply HQ merges BOTH files. Non-empty values in apply_hq/.env override the
# parent. Empty placeholders (NOTION_TOKEN=) do NOT wipe a live token from the
# repo-root .env.
#
# APPLY_HQ_DEMO=1 is IGNORED whenever a live NOTION_TOKEN exists in either file.
# Demo never silently replaces live Mik/Spark (or your own) Ready rows.
#
# Frontend (Vite) has no separate secrets — it proxies /api to the FastAPI backend.

# =============================================================================
# REQUIRED for live Notion queue + CV generation
# =============================================================================

# Notion integration token (https://www.notion.so/my-integrations)
# Can live here OR in the parent repo .env — either works.
NOTION_TOKEN=

# Cursor SDK key for CV / cover-letter generation
# (https://cursor.com/dashboard → Integrations / API)
CURSOR_API_KEY=

# Optional model override (default: composer-2.5)
CURSOR_MODEL=composer-2.5

# =============================================================================
# Notion data sources (replace with YOUR collection IDs if not using Mik/Spark)
# =============================================================================
# From a Notion database URL or API: collection://<uuid> → use the uuid only.
# Defaults below are the shared Mik / Spark trackers — use your own DBs for a
# personal job hunt so you do not write into someone else's tracker.

# Mik Jobs data source (employment)
NOTION_MIK_DATA_SOURCE_ID=c7753833-38f9-4885-958f-547e6129a566

# Spark Projects data source (freelance)
NOTION_SPARK_DATA_SOURCE_ID=d6129604-e8be-4995-93db-a7f1b0a07652

# =============================================================================
# OPTIONAL paths / bind / demo
# =============================================================================

# Override profile / output / prompts dirs (defaults: ../profile, ../output, ../prompts)
# PROFILE_DIR=
# OUTPUT_DIR=
# PROMPTS_DIR=

# Backend + Vite bind (run.py defaults)
APPLY_HQ_HOST=127.0.0.1
APPLY_HQ_PORT=8787
APPLY_HQ_VITE_PORT=5173

# In-memory demo queue (UI smoke ONLY when NOTION_TOKEN is absent from BOTH
# apply_hq/.env and the parent repo .env). If a live token is present, this
# flag is ignored and real Ready rows are used. When demo is actually active,
# the UI shows DEMO in huge letters.
# APPLY_HQ_DEMO=1
