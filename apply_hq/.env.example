# Copy to apply_hq/.env (or repo-root .env). Never commit real secrets.

# Notion integration token (notion.so/my-integrations)
NOTION_TOKEN=

# Cursor SDK key for CV / cover-letter generation (cursor.com/dashboard → Integrations)
CURSOR_API_KEY=

# Optional model override (default: composer-2.5)
# CURSOR_MODEL=composer-2.5

# Mik Jobs data source (employment) — collection://c7753833-38f9-4885-958f-547e6129a566
NOTION_MIK_DATA_SOURCE_ID=c7753833-38f9-4885-958f-547e6129a566

# Spark Projects data source (freelance) — collection://d6129604-e8be-4995-93db-a7f1b0a07652
NOTION_SPARK_DATA_SOURCE_ID=d6129604-e8be-4995-93db-a7f1b0a07652

# Optional: override profile / output dirs (defaults: ../profile, ../output, ../prompts)
# PROFILE_DIR=
# OUTPUT_DIR=
# PROMPTS_DIR=

# Backend bind (run.py defaults)
# APPLY_HQ_HOST=127.0.0.1
# APPLY_HQ_PORT=8787

# Optional: in-memory demo queue (UI smoke ONLY).
# Ignored when NOTION_TOKEN is set — live Mik/Spark always win.
# If demo is actually active (no token), the UI shows DEMO in huge letters.
# APPLY_HQ_DEMO=1
